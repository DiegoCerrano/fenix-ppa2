# LocalStack (credenciales ficticias)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_AUTH_TOKEN=

# Identidad del grupo
GROUP_ID=grupo01

# Webhook
WEBHOOK_SECRET=
WEBHOOK_URL=http://127.0.0.1:8000/webhook

# Aviso: console (desarrollo) o slack (entrega)
NOTIFY_PROVIDER=console
SLACK_WEBHOOK_URL=

# Opcionales
FENIX_LOG_LEVEL=DEBUG
FENIX_LOG_MAX_BYTES=1000000